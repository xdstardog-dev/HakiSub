# 将这些非敏感字段合并到服务器根 .env，不覆盖已有发布标识或密钥。
HAKISUB_PUBLIC_ORIGIN=https://hakisub.xdstar.work
# 现有广州服务器已导入并验证的官方 Caddy 2.11.6 本地镜像ID。
# 其他服务器需重新核验导入结果；原registry摘要与Docker导入后ID不同，见部署文档。
HAKISUB_CADDY_IMAGE=sha256:b81090603cc2ee6442c736e702f3e047feaa0d94cb3867c717327db440d7cf04
# 只有核实本网站备案成功后才改为 yes；示例默认关闭公网。
HAKISUB_ICP_CONFIRMED=no
