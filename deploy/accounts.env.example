# 在服务器环境中注入；实际值不得进Git、聊天或VITE_*。
XDSTAR_ACCOUNT_SECRET=
# 同一Docker私有网络内的房间服务，不能填浏览器Origin；不新增公网内部管理代理。
XDSTAR_HAKISUB_GATEWAY_URL=http://hakisub:8787
# 两服务使用同一独立随机值；同时在房间服务secrets/server.env注入，不能复用账号/加密主密钥。
HAKISUB_ROOM_MANAGEMENT_SECRET=
# 上线前实测Caddy到新账号容器的peer，仅填精确IP，不设置trust-all。
XDSTAR_ACCOUNT_TRUSTED_PROXIES=
XDSTAR_REGISTER_ATTEMPTS=5
XDSTAR_REGISTER_SUCCESSES=3
XDSTAR_REGISTER_DAILY_WARNING=100
XDSTAR_ARGON_MEMORY_KIB=19456
XDSTAR_ARGON_ITERATIONS=2
XDSTAR_HASH_CONCURRENCY=1
XDSTAR_HASH_QUEUE=8
