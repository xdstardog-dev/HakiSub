# 仅在 ICP 备案成功、DNS 和防火墙核验后启用。
{
	admin off
	servers {
		protocols h1 h2
	}
	log {
		format filter {
			wrap json
			# 运行错误可能携带请求对象，移除它以免记录成员令牌。
			request delete
		}
	}
}

