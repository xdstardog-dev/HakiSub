	tls {
		issuer acme https://acme-v02.api.letsencrypt.org/directory
	}
	# 同源代理网页、房间和 ASR；Caddy 自动处理 WebSocket Upgrade。
	reverse_proxy 127.0.0.1:18787
	# 不启用访问日志；不改写路径、Origin 或 session 参数。
}
